---
import Layout from "../layouts/Layout.astro";
import HeroStack from "../components/HeroStack.astro";
---

<Layout title="The Social Club — Case Studies">
  <HeroStack />

  <main class="after">
    <section class="after__section">
      <h2>Scroll past the stack</h2>
      <p>
        The three case-study slides above stay pinned to the viewport while you scroll through
        them. Once the last slide has fully settled, the page continues scrolling normally from
        here.
      </p>
    </section>
  </main>
</Layout>

<style>
  .after {
    background: #0c0a12;
    color: #f4f1fa;
    position: relative;
    z-index: 0;
  }

  .after__section {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(4rem, 12vw, 8rem) 1.5rem;
    text-align: center;
  }

  .after__section h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
  }

  .after__section p {
    font-family: var(--font-body);
    line-height: 1.6;
    color: rgba(244, 241, 250, 0.75);
    margin: 0;
  }
</style>

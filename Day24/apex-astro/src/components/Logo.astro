---
interface Props {
  size?: number;
  class?: string;
  color?: string;
}
const { size = 28, class: className = '', color = '#5b7cf5' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <polygon id="apex-hex" points="0,-5.6 4.85,-2.8 4.85,2.8 0,5.6 -4.85,2.8 -4.85,-2.8" />
  </defs>
  <g fill={color}>
    <use href="#apex-hex" transform="translate(20 20) translate(0 -8.6)" />
    <use href="#apex-hex" transform="translate(20 20) rotate(60) translate(0 -8.6)" />
    <use href="#apex-hex" transform="translate(20 20) rotate(120) translate(0 -8.6)" />
    <use href="#apex-hex" transform="translate(20 20) rotate(180) translate(0 -8.6)" />
    <use href="#apex-hex" transform="translate(20 20) rotate(240) translate(0 -8.6)" />
    <use href="#apex-hex" transform="translate(20 20) rotate(300) translate(0 -8.6)" />
  </g>
</svg>

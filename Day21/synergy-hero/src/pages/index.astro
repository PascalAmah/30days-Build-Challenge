---
// Feature data drives both the tab list and the "spotlight" region that
// gets highlighted on the dashboard screenshot when a tab is selected.
// x / y / w / h are percentages of the screenshot's own box, so the
// highlight stays correctly positioned at any viewport size.
const features = [
  {
    id: "tracking",
    label: "Smart time tracking",
    desc: "Manage leave and attendance",
    url: "hr-template.com/time-off",
    icon: "clock",
    region: { x: 21, y: 10, w: 25, h: 43 },
  },
  {
    id: "feedback",
    label: "Real-time feedback",
    desc: "Stay connected as one network",
    url: "hr-template.com/notes",
    icon: "chat",
    region: { x: 47, y: 54, w: 25, h: 44 },
  },
  {
    id: "scheduling",
    label: "Simplified scheduling",
    desc: "Simplify daily team planning",
    url: "hr-template.com/schedule",
    icon: "calendar",
    region: { x: 73, y: 10, w: 25.5, h: 88 },
  },
  {
    id: "visibility",
    label: "Employee visibility",
    desc: "Track morale and engagement",
    url: "hr-template.com/team",
    icon: "heart",
    region: { x: 21, y: 54, w: 25, h: 44 },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Synergy — Deep Research, Fully Autonomous</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Announcement banner -->
    <div class="banner" id="banner">
      <p>
        <span class="banner-label">Latest update:</span> Time-off approvals now
        faster
        <a href="#" class="banner-link">Learn more <span aria-hidden="true">↗</span></a>
      </p>
      <button class="banner-close" id="bannerClose" aria-label="Dismiss announcement">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <!-- Nav -->
    <header class="nav">
      <div class="nav-inner">
        <div class="nav-left">
          <a href="#" class="brand" aria-label="Synergy">
            <svg
              class="brand-logo"
              width="106"
              height="24"
              viewBox="0 0 106 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-hidden="true"
            >
              <path d="M11 2.65H20.35V12L11 2.65Z" fill="#335CFF" />
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M11 12V2.65H6.325L1.65 7.325V12V21.35H11H15.675L20.35 16.675V12H11ZM11 12V21.35L1.65 12H11Z"
                fill="#335CFF"
              />
              <path
                d="M33.7305 19.2109C32.1602 19.2109 30.9209 18.8154 30.0127 18.0244C29.1104 17.2275 28.6592 16.1377 28.6592 14.7549H30.6104C30.6162 15.6162 30.8916 16.29 31.4365 16.7764C31.9873 17.2627 32.752 17.5059 33.7305 17.5059C34.6211 17.5059 35.333 17.3184 35.8662 16.9434C36.4053 16.5625 36.6748 16.0527 36.6748 15.4141C36.6748 14.9102 36.4814 14.5029 36.0947 14.1924C35.7139 13.876 35.0693 13.6094 34.1611 13.3926L32.7285 13.0498C31.4043 12.7334 30.4375 12.2939 29.8281 11.7314C29.2246 11.1631 28.9229 10.4248 28.9229 9.5166C28.9229 8.74902 29.1162 8.07812 29.5029 7.50391C29.8896 6.92969 30.4316 6.48438 31.1289 6.16797C31.832 5.85156 32.6523 5.69336 33.5898 5.69336C35.002 5.69336 36.124 6.0625 36.9561 6.80078C37.7939 7.53906 38.2334 8.54688 38.2744 9.82422H36.3848C36.3379 9.06836 36.0625 8.47656 35.5586 8.04883C35.0547 7.61523 34.3896 7.39844 33.5635 7.39844C32.7725 7.39844 32.125 7.58887 31.6211 7.96973C31.1172 8.34473 30.8652 8.82812 30.8652 9.41992C30.8652 9.89453 31.0586 10.2812 31.4453 10.5801C31.832 10.873 32.4736 11.1279 33.3701 11.3447L34.7852 11.6787C36.0977 11.9893 37.0645 12.4375 37.6855 13.0234C38.3125 13.6094 38.626 14.3711 38.626 15.3086C38.626 16.0938 38.4238 16.7793 38.0195 17.3652C37.6152 17.9512 37.0469 18.4053 36.3145 18.7275C35.582 19.0498 34.7207 19.2109 33.7305 19.2109ZM40.4541 22.6738V21.1094H41.4561C41.749 21.1094 41.9863 21.0244 42.168 20.8545C42.3555 20.6904 42.5195 20.418 42.6602 20.0371L43.082 18.9385L39.4961 9.71875H41.4824L43.3369 14.8076C43.46 15.1533 43.5801 15.502 43.6973 15.8535C43.8145 16.1992 43.9287 16.5449 44.04 16.8906C44.1514 16.5449 44.2656 16.1992 44.3828 15.8535C44.5059 15.502 44.6289 15.1533 44.752 14.8076L46.5801 9.71875H48.54L44.3213 20.626C43.7998 21.9912 42.9033 22.6738 41.6318 22.6738H40.4541ZM51.6602 13.6562V19H49.8057V9.71875H51.625V11.1162C52.2578 10.0615 53.1924 9.53418 54.4287 9.53418C55.0674 9.53418 55.6387 9.6748 56.1426 9.95605C56.6523 10.2314 57.0537 10.6416 57.3467 11.1865C57.6396 11.7314 57.7861 12.4082 
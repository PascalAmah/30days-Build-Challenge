744 18.0801 81.3672 18.4785 80.875 18.7363C80.3887 18.9941 79.8408 19.123 79.2314 19.123C78.4229 19.123 77.7168 18.9209 77.1133 18.5166C76.5098 18.1064 76.041 17.5439 75.707 16.8291C75.373 16.1084 75.2061 15.2764 75.2061 14.333C75.2061 13.3896 75.373 12.5576 75.707 11.8369C76.0469 11.1162 76.5186 10.5537 77.1221 10.1494C77.7256 9.73926 78.4258 9.53418 79.2227 9.53418C79.8262 9.53418 80.3799 9.66309 80.8838 9.9209C81.3877 10.1787 81.7949 10.583 82.1055 11.1338H82.1143V9.71875H83.9424V18.877C83.9424 19.8145 83.752 20.5703 83.3711 21.1445C82.9902 21.7188 82.4805 22.1377 81.8418 22.4014C81.2031 22.665 80.4941 22.7969 79.7148 22.7969ZM79.6094 17.5322C80.4004 17.5322 81.0303 17.2422 81.499 16.6621C81.9736 16.0762 82.2109 15.2969 82.2109 14.3242C82.2109 13.3516 81.9736 12.5752 81.499 11.9951C81.0303 11.4092 80.4004 11.1162 79.6094 11.1162C78.8594 11.1162 78.25 11.3916 77.7812 11.9424C77.3184 12.4873 77.0869 13.2812 77.0869 14.3242C77.0869 15.3672 77.3184 16.1641 77.7812 16.7148C78.25 17.2598 78.8594 17.5322 79.6094 17.5322ZM86.1572 22.6738V21.1094H87.1592C87.4521 21.1094 87.6895 21.0244 87.8711 20.8545C88.0586 20.6904 88.2227 20.418 88.3633 20.0371L88.7852 18.9385L85.1992 9.71875H87.1855L89.04 14.8076C89.1631 15.1533 89.2832 15.502 89.4004 15.8535C89.5176 16.1992 89.6318 16.5449 89.7432 16.8906C89.8545 16.5449 89.9688 16.1992 90.0859 15.8535C90.209 15.502 90.332 15.1533 90.4551 14.8076L92.2832 9.71875H94.2432L90.0244 20.626C89.5029 21.9912 88.6064 22.6738 87.335 22.6738H86.1572Z"
                fill="#171717"
              />
              <path
                d="M101.775 10.6152L100.457 7.55664V10.6152H99.5342V5.9043H100.65L102.021 9.26172L103.393 5.9043H104.518V10.6152H103.586V7.57422L102.276 10.6152H101.775ZM96.3525 10.6152V6.7041H94.9287V5.9043H98.708V6.7041H97.2842V10.6152H96.3525Z"
                fill="#A4A4A4"
              />
            </svg>
          </a>

          <nav class="nav-links" aria-label="Primary">
            <a href="#">Products</a>
            <a href="#">Pricing</a>
            <a href="#">Contact</a>
          </nav>
        </div>

        <div class="nav-actions">
          <a href="#" class="btn btn-ghost">Sign in</a>
          <a href="#" class="btn btn-demo">Request a demo</a>
        </div>

        <button class="nav-burger" id="navBurger" aria-label="Toggle menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="#0f172a" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="nav-mobile" id="navMobile">
        <a href="#">Products</a>
        <a href="#">Pricing</a>
        <a href="#">Contact</a>
        <div class="nav-mobile-actions">
          <a href="#" class="btn btn-ghost">Sign in</a>
          <a href="#" class="btn btn-demo">Request a demo</a>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <main>
      <section class="hero">
        <div class="eyebrow">
          <span class="pill-new">NEW</span>
          People-first agent for your team
        </div>

        <h1>Deep Research, Fully <br />Autonomous.</h1>

        <p class="hero-sub">
          Move past static reports. Synergy deploys specialized AI agents to
          crawl, audit, and analyze thousands of sources simultaneously.
        </p>

        <div class="hero-ctas">
          <a href="#" class="btn btn-primary btn-lg">Book a demo <span aria-hidden="true">↗</span></a>
          <a href="#" class="btn btn-outline btn-lg">See it in action</a>
        </div>
      </section>

      <!-- Feature tabs -->
      <section class="features" aria-label="Product features">
        <div class="features-rule"></div>
        <div class="feature-tabs" role="tablist">
          {features.map((f, i) => (
            <button
              class="feature-tab"
              class:list={[{ active: i === 0 }]}
              data-feature={f.id}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              <span class="feature-icon" data-icon={f.icon}>
                {f.icon === "clock" && (
                  <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" />
                    <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {f.icon === "chat" && (
                  <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                    <path d="M4 5.5h16v10H9l-4 3.5v-3.5H4v-10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  </svg>
                )}
                {f.icon === "calendar" && (
                  <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                    <rect x="3.5" y="5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.7" />
                    <path d="M3.5 9.5h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  </svg>
                )}
                {f.icon === "heart" && (
                  <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                    <path d="M12 20s-7.5-4.6-9.7-9.1C.6 7.4 2.4 4 6 4c2 0 3.4 1.1 4 2.4C10.6 5.1 12 4 14 4c3.6 0 5.4 3.4 3.7 6.9C19.5 15.4 12 20 12 20Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  </svg>
                )}
              </span>
              <span class="feature-copy">
                <span class="feature-title">{f.label}</span>
                <span class="feature-desc">{f.desc}</span>
              </span>
            </button>
          ))}
        </div>
      </section>

      <!-- Dashboard showcase -->
      <section class="showcase">
        <div class="showcase-bg">
          <img src="/images/bg-pattern.jpg" alt="" aria-hidden="true" />
        </div>

        <div class="browser">
          <div class="browser-topbar">
            <div class="browser-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="browser-url">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                <rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8" />
              </svg>
              <span id="urlBarText">{features[0].url}</span>
            </div>
            <div class="browser-icons">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v12m0 0 4-4m-4 4-4-4M4 20h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
          </div>

          <div class="browser-body">
            <img src="/images/dashboard.jpg" alt="Synergy HR dashboard showing time off, current project, schedule and notes" class="dashboard-img" />
            <div class="spotlight" id="spotlight"></div>
          </div>
        </div>
      </section>
    </main>

    <script define:vars={{ features }}>
      const regions = Object.fromEntries(features.map((f) => [f.id, f]));
      const tabs = document.querySelectorAll(".feature-tab");
      const spotlight = document.getElementById("spotlight");
      const urlText = document.getElementById("urlBarText");

      function activate(id) {
        const f = regions[id];
        if (!f) return;

        tabs.forEach((t) => {
          const isActive = t.dataset.feature === id;
          t.classList.toggle("active", isActive);
          t.setAttribute("aria-selected", String(isActive));
        });

        const r = f.region;
        spotlight.style.left = r.x + "%";
        spotlight.style.top = r.y + "%";
        spotlight.style.width = r.w + "%";
        spotlight.style.height = r.h + "%";
        urlText.textContent = f.url;
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activate(tab.dataset.feature));
      });

      // Initial state
      activate(features[0].id);

      // Banner dismiss
      const banner = document.getElementById("banner");
      document.getElementById("bannerClose")?.addEventListener("click", () => {
        banner.style.display = "none";
      });

      // Mobile nav toggle
      const burger = document.getElementById("navBurger");
      const mobileMenu = document.getElementById("navMobile");
      burger?.addEventListener("click", () => {
        const open = mobileMenu.classList.toggle("open");
        burger.setAttribute("aria-expanded", String(open));
      });
    </script>

    <style is:global>
      :root {
        --blue: #3d5df5;
        --blue-dark: #2d46d1;
        --ink: #0f1729;
        --ink-soft: #55607a;
        --line: #e7e9f0;
        --bg-soft: #f7f8fb;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Inter", "Helvetica Neue", Arial, system-ui, -apple-system,
          sans-serif;
        color: var(--ink);
        background: #ffffff;
        -webkit-font-smoothing: antialiased;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      /* Banner */
      .banner {
        background: var(--blue);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 0.65rem 3rem 0.65rem 1rem;
        font-size: 0.85rem;
        position: relative;
        text-align: center;
      }
      .banner p {
        margin: 0;
      }
      .banner-label {
        font-weight: 600;
      }
      .banner-link {
        margin-left: 0.5rem;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
        white-space: nowrap;
      }
      .banner-close {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #fff;
        opacity: 0.85;
        cursor: pointer;
        padding: 0.25rem;
        display: flex;
      }
      .banner-close:hover {
        opacity: 1;
      }

      /* Nav */
      .nav {
        border-bottom: 1px solid var(--line);
      }
      .nav-inner {
        max-width: 1600px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 6.25rem;
      }
      .nav-left {
        display: flex;
        align-items: center;
        gap: 2.75rem;
      }
      .brand {
        display: flex;
        align-items: center;
      }
      .brand-logo {
        display: block;
        height: 34px;
        width: auto;
      }
      .nav-links {
        display: flex;
        gap: 2.25rem;
        font-size: 0.92rem;
        color: var(--ink-soft);
      }
      .nav-links a:hover {
        color: var(--ink);
      }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .nav-burger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.25rem;
      }
      .nav-mobile {
        display: none;
        flex-direction: column;
        gap: 0.9rem;
        padding: 0 1.25rem 1.25rem;
        font-size: 0.95rem;
      }
      .nav-mobile.open {
        display: flex;
      }
      .nav-mobile-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.4rem;
      }
      .nav-mobile-actions .btn {
        flex: 1;
        justify-content: center;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.55rem 1.15rem;
        border-radius: 10px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        white-space: nowrap;
      }
      .btn-primary {
        background: var(--blue);
        color: #fff;
        box-shadow: 0 1px 2px rgba(61, 93, 245, 0.25);
      }
      .btn-primary:hover {
        background: var(--blue-dark);
        transform: translateY(-1px);
      }
      .btn-ghost {
        background: #fff;
        color: var(--ink);
        border-color: var(--line);
      }
      .btn-ghost:hover {
        border-color: #c7cbdb;
      }
      .btn-demo {
        background: #fff;
        color: var(--blue);
        border-color: var(--blue);
      }
      .btn-demo:hover {
        background: var(--blue);
        color: #fff;
      }
      .btn-outline {
        background: #fff;
        color: var(--ink);
        border-color: #dfe2ec;
      }
      .btn-outline:hover {
        border-color: #b9beD3;
        transform: translateY(-1px);
      }
      .btn-lg {
        padding: 0.8rem 1.6rem;
        font-size: 0.98rem;
        border-radius: 999px;
      }

      /* Hero */
      .hero {
        max-width: 860px;
        margin: 0 auto;
        text-align: center;
        padding: 4.5rem 1.5rem 3rem;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.85rem;
        color: var(--ink-soft);
        background: var(--bg-soft);
        border: 1px solid var(--line);
        padding: 0.35rem 0.9rem 0.35rem 0.4rem;
        border-radius: 999px;
        margin-bottom: 1.75rem;
      }
      .pill-new {
        background:  #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
      }
      h1 {
        font-family: "Bricolage Grotesque", "Inter", "Helvetica Neue", Arial,
          system-ui, sans-serif;
        font-size: 66px;
        font-weight: 600;
        line-height: 1.06;
        letter-spacing: -0.03em;
        margin: 0 0 1.5rem;
      }
      .hero-sub {
        font-size: 1.08rem;
        line-height: 1.6;
        color: var(--ink-soft);
        max-width: 620px;
        margin: 0 auto 2.25rem;
      }
      .hero-ctas {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
        flex-wrap: wrap;
      }
      .hero-ctas .btn {
        border-radius: 10px;
      }

      /* Feature tabs */
      .features {
        max-width: 1224px;
        margin: 0 auto;
      }
      .features-rule {
        height: 1px;
        background: var(--line);
        margin-bottom: 0;
      }
      .feature-tabs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }
      .feature-tab {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        text-align: left;
        background: none;
        border: none;
        border-top: 2px solid transparent;
        cursor: pointer;
        padding: 1.4rem 1.1rem 1.4rem 0.25rem;
        margin-top: -1px;
        transition: border-color 0.2s ease;
      }
      .feature-tab:first-child {
        padding-left: 0;
      }
      .feature-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--bg-soft);
        color: var(--ink-soft);
        border: 1px solid var(--line);
        transition: all 0.2s ease;
      }
      .feature-copy {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .feature-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--ink-soft);
        transition: color 0.2s ease;
      }
      .feature-desc {
        font-size: 0.82rem;
        color: #97a0b8;
      }
      .feature-tab.active {
        border-top-color: var(--blue);
      }
      .feature-tab.active .feature-icon {
        background: #fff;
        color: var(--blue);
        border-color: var(--blue);
        box-shadow: 0 4px 12px rgba(61, 93, 245, 0.25);
      }
      .feature-tab.active .feature-title {
        color: var(--ink);
      }
      .feature-tab:hover .feature-title {
        color: var(--ink);
      }

      /* Showcase */
.showcase {
        position: relative;
        max-width: 1224px;
        margin: 0 auto 5rem;
        padding: 5rem 1.5rem 0;
      }
      .showcase-bg {
        position: absolute;
        inset: 0;
        overflow: hidden;
        z-index: 0;
      }
      .showcase-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .browser {
        position: relative;
        z-index: 1;
        max-width: 984px;
        margin: 0 auto;
        background: #fff;
        box-shadow: 0 30px 60px -20px rgba(15, 23, 41, 0.35);
        overflow: hidden;
      }
      .browser-topbar {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.65rem 0.9rem;
        border-bottom: 1px solid var(--line);
        background: #fbfbfd;
      }
      .browser-dots {
        display: flex;
        gap: 0.4rem;
        flex-shrink: 0;
      }
      .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
      }
      .dot-red {
        background: #ff5f57;
      }
      .dot-yellow {
        background: #febc2e;
      }
      .dot-green {
        background: #28c840;
      }
      .browser-url {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.35rem 0.9rem;
        font-size: 0.78rem;
        color: var(--ink-soft);
        max-width: 420px;
        margin: 0 auto;
      }
      .browser-icons {
        display: flex;
        gap: 0.6rem;
        color: var(--ink-soft);
        flex-shrink: 0;
      }
      .browser-body {
        position: relative;
        line-height: 0;
      }
      .dashboard-img {
        display: block;
        width: 100%;
        height: auto;
      }
      .spotlight {
        position: absolute;
        border: 2px solid var(--blue);
        border-radius: 10px;
        box-shadow: 0 0 0 2000px rgba(10, 14, 28, 0.3);
        transition: left 0.5s cubic-bezier(0.16, 1, 0.3, 1),
          top 0.5s cubic-bezier(0.16, 1, 0.3, 1),
          width 0.5s cubic-bezier(0.16, 1, 0.3, 1),
          height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: left, top, width, height;
        pointer-events: none;
      }

      /* Entrance animation */
      @media (prefers-reduced-motion: no-preference) {
        @keyframes rise {
          from {
            opacity: 0;
            transform: translateY(18px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
        .banner {
          animation: rise 0.5s ease-out both;
        }
        .nav {
          animation: rise 0.5s ease-out both;
        }
        .hero > * {
          animation: rise 0.6s ease-out both;
        }
        .hero > *:nth-child(1) {
          animation-delay: 0.1s;
        }
        .hero > *:nth-child(2) {
          animation-delay: 0.2s;
        }
        .hero > *:nth-child(3) {
          animation-delay: 0.3s;
        }
        .hero > *:nth-child(4) {
          animation-delay: 0.4s;
        }
        .features {
          animation: rise 0.6s ease-out both;
          animation-delay: 0.5s;
        }
        .showcase {
          animation: rise 0.6s ease-out both;
          animation-delay: 0.6s;
        }
      }

      /* Responsive */
      @media (max-width: 900px) {
        .nav {
          position: relative;
          z-index: 50;
        }
        .nav-links,
        .nav-actions {
          display: none;
        }
        .nav-burger {
          display: flex;
        }
        .nav-mobile {
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: #fff;
          border-bottom: 1px solid var(--line);
          box-shadow: 0 24px 40px -20px rgba(15, 23, 41, 0.25);
        }
        .feature-tabs {
          grid-template-columns: 1fr 1fr;
          row-gap: 0.25rem;
        }
        .feature-tab:nth-child(odd) {
          padding-left: 0;
        }
        .feature-tab:nth-child(even) {
          padding-right: 0;
        }
      }

      @media (max-width: 640px) {
        .nav-inner {
          padding: 1.25rem;
        }
        .banner {
          font-size: 0.95rem;
          padding: 0.6rem 2.6rem 0.6rem 0.75rem;
        }
        .banner p {
          display: flex;
          gap: 0.15rem;
        }
        .hero {
          padding: 3rem 1.25rem 2rem;
        }
        h1 {
          font-size: clamp(2.4rem, 11vw, 66px);
          letter-spacing: -0.02em;
        }
        .feature-tabs {
          grid-template-columns: 1fr;
        }
        .features {
          padding: 0 1.25rem;
        }
        .feature-tab {
          padding-left: 0 !important;
          padding-right: 0 !important;
        }
        .browser-url {
          max-width: none;
        }
        .browser-url span {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .showcase-bg {
          inset: 0.5rem 0.75rem -1.5rem;
        }
        .spotlight {
          border-width: 1.5px;
          border-radius: 8px;
        }
      }
    </style>
  </body>
</html>

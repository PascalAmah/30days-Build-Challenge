---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    num: '01',
    title: 'Brand',
    color: 'yellow',
    img: 'https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=400&h=500&fit=crop&crop=faces',
    desc: 'Identity systems built to be recognized before they\u2019re read \u2014 logo, color, type, and the rules that keep it consistent everywhere it shows up.',
  },
  {
    num: '02',
    title: 'Campaign',
    color: 'red',
    img: 'https://images.unsplash.com/photo-1542744094-3a31f272c490?w=400&h=500&fit=crop&crop=center',
    desc: 'Concept-first creative for launches and drops: key visuals, motion, and adaptable templates that hold together across every channel.',
  },
  {
    num: '03',
    title: 'Content',
    color: 'violet',
    img: 'https://images.unsplash.com/photo-1611532736597-de2d4265fba3?w=400&h=500&fit=crop&crop=center',
    desc: 'Ongoing design support for the content calendar \u2014 social sets and motion loops your team can run week to week without a designer.',
  },
  {
    num: '04',
    title: 'AI design',
    color: 'ink',
    img: 'https://images.unsplash.com/photo-1677442135703-1787eea5ce01?w=400&h=500&fit=crop&crop=center',
    desc: 'Generative tooling folded into the workflow, from rapid concepting to on-brand asset variants at a pace hand-crafting can\u2019t match.',
  },
];
---

<Layout title="Services">
  <section class="services">
    <div class="services__inner">
      <header class="services__intro">
        <p class="eyebrow">services i offer</p>
        <h2 class="headline">Turning heads and<br />conquering hearts</h2>
        <p class="subhead">
          We turn your vision into a considered, unmistakable identity &mdash; through
          a design process that stays collaborative from first sketch to launch.
        </p>
      </header>

      <div class="services__list" id="list">
        {
          services.map((s, i) => (
            <div
              class="row"
              data-index={i}
              data-color={s.color}
              tabindex="0"
            >
              <span class="row__num">{s.num}</span>
              <h3 class="row__title">{s.title}</h3>
              <p class="row__desc">{s.desc}</p>
              <div class="row__reveal">
                <img src={s.img} alt={s.title} />
              </div>
            </div>
          ))
        }

        <div class="visual" id="visual" aria-hidden="true">
          <div class="visual__shadow"></div>
          <div class="visual__card">
            {
              services.map((s, i) => (
                <div class="visual__img" data-img={i}>
                  <img src={s.img} alt={s.title} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services {
    padding: clamp(2.5rem, 6vw, 6rem) clamp(1.25rem, 6vw, 4.5rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  .eyebrow {
    font-family: 'Caveat', cursive;
    font-size: 1.5rem;
    color: var(--muted);
    margin: 0 0 0.25rem;
  }

  .headline {
    font-family: 'SF Pro Display', 'SF Pro', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: 90px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  @media (max-width: 860px) {
    .headline {
      font-size: clamp(2.8rem, 11vw, 4rem);
      letter-spacing: -0.025em;
    }
  }

  .subhead {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--muted);
    max-width: 34rem;
    line-height: 1.5;
    margin: 0 0 3rem;
  }

  .services__list {
    position: relative;
    border-top: 1px solid var(--line);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    column-gap: 1.5rem;
    padding: 1.6rem 0.5rem;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    z-index: 1;
    outline: none;
  }

  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.32s cubic-bezier(0.65, 0, 0.35, 1);
    z-index: -1;
  }

  .row.is-active::before {
    transform: scaleY(1);
  }

  .row__num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.25s ease;
  }

  .row__title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.7rem, 2.6vw, 2.6rem);
    margin: 0;
    grid-column: 2;
    transition: color 0.25s ease;
  }

  .row__desc {
    grid-column: 2;
    max-width: 26rem;
    justify-self: end;
    text-align: right;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0.35rem 0 0;
    transition: color 0.25s ease;
  }

  .row.is-active .row__num,
  .row.is-active .row__title {
    color: var(--paper);
  }

  .row.is-active .row__desc {
    color: #cfcdc6;
  }

  /* Desktop: title / description side by side; floating panel in between */
  @media (min-width: 861px) {
    .row {
      grid-template-columns: 5rem minmax(10rem, 1fr) auto;
      column-gap: 2rem;
    }
    .row__title {
      grid-column: 2;
    }
    .row__desc {
      grid-column: 3;
      justify-self: start;
      text-align: left;
    }
    .row__reveal {
      display: none;
    }
  }

  /* Floating visual panel (desktop) */
  .visual {
    position: absolute;
    left: 38%;
    top: 0;
    width: clamp(200px, 20vw, 260px);
    height: clamp(220px, 22vw, 310px);
    pointer-events: none;
    transition: transform 0.42s cubic-bezier(0.65, 0, 0.35, 1);
    z-index: 2;
  }

  .visual__shadow {
    position: absolute;
    inset: 10% 6% -6% 10%;
    background: var(--ink);
    opacity: 0.16;
    border-radius: 4px;
    transform: skew(-6deg, 0);
  }

  .visual__card {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    background: var(--panel-color, var(--yellow));
    box-shadow: 0 1.5px 0 rgba(20, 20, 18, 0.9);
    border: 1.5px solid var(--ink);
    overflow: hidden;
    transition: background 0.32s ease;
  }

  .visual__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.32s ease, transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .visual__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .visual__img.is-shown {
    opacity: 1;
    transform: scale(1);
  }

  /* Mobile: hide floating panel, show inline image on active row */
  @media (max-width: 860px) {
    .visual {
      display: none;
    }
    .row {
      grid-template-columns: 3.5rem 1fr;
      padding: 1.3rem 0.35rem;
    }
    .row__desc {
      padding-right: 0.25rem;
    }
    .row__reveal {
      grid-column: 1 / -1;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.36s ease, opacity 0.28s ease;
    }
    .row__reveal img {
      width: 100px;
      height: 120px;
      object-fit: cover;
      border-radius: 4px;
      margin-top: 1rem;
      display: block;
      border: 1.5px solid var(--ink);
    }
    .row.is-active .row__reveal {
      max-height: 160px;
      opacity: 1;
    }
  }
</style>

<script>
  const list = document.getElementById('list') as HTMLElement;
  const rows = Array.from(list.querySelectorAll<HTMLElement>('.row'));
  const visual = document.getElementById('visual') as HTMLElement;
  const imgs = Array.from(visual.querySelectorAll<HTMLElement>('.visual__img'));

  let active = 0;

  function activate(i: number) {
    active = i;
    rows.forEach((row, idx) => row.classList.toggle('is-active', idx === i));
    imgs.forEach((img, idx) => img.classList.toggle('is-shown', idx === i));

    const row = rows[i];
    const color = row.dataset.color;
    if (color) visual.style.setProperty('--panel-color', `var(--${color})`);

    const listRect = list.getBoundingClientRect();
    const rowRect = row.getBoundingClientRect();
    const visualHeight = visual.offsetHeight;

    let top = rowRect.top - listRect.top + rowRect.height / 2 - visualHeight / 2;
    top = Math.max(0, Math.min(top, list.offsetHeight - visualHeight));
    visual.style.transform = `translateY(${top}px)`;
  }

  rows.forEach((row, i) => {
    row.addEventListener('mouseenter', () => activate(i));
    row.addEventListener('focus', () => activate(i));
    row.addEventListener('click', () => activate(i));
  });

  window.addEventListener('resize', () => activate(active));

  // Initial state: first service active on load
  requestAnimationFrame(() => activate(0));
</script>

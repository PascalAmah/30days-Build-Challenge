---

const navLinks = [
  { label: "Home", href: "#", active: true },
  { label: "Work", href: "#" },
  { label: "About", href: "#" },
  { label: "Contact", href: "#" },
];

const wordmark = "BASIN".split("");

const taglineWords =
  "We build mobile apps and bold campaigns that help growing brands make real impact. A creative agency that loves to show off — starting with your brand."
    .split(" ");

const apps = [
  { id: "goodrx", src: "/goodrx.png", accent: "#FFD100" },
  { id: "uber", src: "/uber.png", accent: "#1DB954" },
  { id: "coupang", src: "/coupang.png", accent: "#D9A441" },
  { id: "zomato", src: "/zomato.png", accent: "#FF6F91" },
  { id: "tempo", src: "/tempo.png", accent: "#0A0A0A", dark: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Basin — Mobile apps and bold campaigns</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta
      name="description"
      content="Basin is a creative agency that builds mobile apps and bold campaigns to help growing brands make real impact."
    />
    <style>
      :root {
        --ink: #0a0a0a;
        --paper: #ffffff;
        --line: rgba(10, 10, 10, 0.85);
        --border: #E0E0E0;
        --accent: #ff3b00;
        --mute: #9a9a9a;
        --wordmark-size: clamp(4.5rem, 10.5vw, 9.5rem);
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-font-smoothing: antialiased;
      }

      body {
        margin: 0 auto;
        background: var(--paper);
        color: var(--ink);
        font-family: "Geist", "Helvetica Neue", Helvetica, Arial, sans-serif;
        overflow-x: hidden;
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
        min-height: 100vh;
        width: 92%;
        max-width: 1400px;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---------- Masthead: two columns only ---------- */

      .masthead {
        display: grid;
        grid-template-columns: minmax(220px, 34%) 1fr;
        border-bottom: 1px solid var(--border);
      }

      .col-logo {
        border-right: 1px solid var(--border);
        padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.5rem, 3vw, 2.75rem) clamp(1.5rem, 3vw, 2.75rem) 0.75rem;
      }

      .col-content {
        padding: clamp(1.5rem, 3vw, 2.75rem) 0.75rem;
        display: flex;
        flex-direction: column;
        min-height: clamp(420px, 58vh, 620px);
      }

      /* logo */
      .logo {
        font-family: "Geist", sans-serif;
        font-size: 30.67px;
        font-weight: 600;
        letter-spacing: -0.02em;
        display: inline-flex;
        align-items: baseline;
        gap: 0.15em;
        cursor: default;
        width: fit-content;
      }

      .logo sup {
        font-size: 0.55em;
        font-weight: 400;
      }

      .logo-mark {
        transition: letter-spacing 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .logo:hover .logo-mark {
        letter-spacing: 0.02em;
      }

      /* top row inside col-content: nav (left) + email (right) */
      .content-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
      }

      nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      nav li a {
        position: relative;
        display: inline-block;
        font-family: "Geist", sans-serif;
        font-size: 18px;
        font-weight: 500;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: var(--mute);
        padding-bottom: 2px;
        transition: opacity 0.3s ease, color 0.3s ease;
      }

      nav li a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      }

      nav li a[data-active="true"] {
        color: var(--ink);
      }

      nav li a[data-active="true"]::after {
        transform: scaleX(1);
      }

      nav li a:hover {
        color: var(--ink);
      }

      nav li a:hover::after {
        transform: scaleX(1);
      }

      nav.is-hovering li a:not(:hover) {
        opacity: 0.45;
      }

      .contact-line {
        font-family: "Geist", sans-serif;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-underline-offset: 4px;
        text-decoration: underline;
        text-decoration-color: var(--ink);
        white-space: nowrap;
        transition: text-decoration-color 0.3s ease, color 0.3s ease;
      }

      .contact-line:hover {
        text-decoration-color: var(--accent);
        color: var(--accent);
      }

      /* wordmark + tagline sit BELOW the nav, in the same column,
         pinned toward the bottom of the header block */
      .hero-copy {
        margin-top: auto;
        padding-top: 3rem;
      }

      .wordmark-wrap {
        user-select: none;
        margin-bottom: 1.5rem;
      }

      .wordmark {
        margin: 0;
        display: flex;
        line-height: 0.82;
        font-family: "Geist", sans-serif;
        font-weight: 700;
        font-size: 150px;
        letter-spacing: -0.03em;
      }

      .wordmark .letter {
        display: inline-block;
        transform: translateY(0);
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
          color 0.3s ease;
        will-change: transform;
      }

      .wordmark .letter.hot {
        color: var(--accent);
      }

      .tagline {
        max-width: 70ch;
        font-family: "Geist", sans-serif;
        font-size: 22px;
        font-weight: 400;
        line-height: 1.5;
        color: var(--mute);
        margin: 0;
      }

      .tagline span {
        display: inline-block;
        opacity: 0;
        transform: translateY(0.4em);
        filter: blur(3px);
        transition: opacity 0.5s ease, transform 0.5s ease, filter 0.5s ease,
          color 0.2s ease;
      }

      .tagline.in-view span {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }

      .tagline span:hover {
        color: var(--ink);
        cursor: default;
      }

      /* ---------- Page-load entry ---------- */

      .masthead {
        animation: masthead-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      @keyframes masthead-in {
        from {
          opacity: 0;
          transform: translateY(-14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .wordmark .letter {
        animation: letter-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      }

      .wordmark .letter:nth-child(1) {
        animation-delay: 0.12s;
      }
      .wordmark .letter:nth-child(2) {
        animation-delay: 0.18s;
      }
      .wordmark .letter:nth-child(3) {
        animation-delay: 0.24s;
      }
      .wordmark .letter:nth-child(4) {
        animation-delay: 0.3s;
      }
      .wordmark .letter:nth-child(5) {
        animation-delay: 0.36s;
      }

      @keyframes letter-rise {
        from {
          opacity: 0;
          transform: translateY(0.5em);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ---------- Screens strip ---------- */

      .screens {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
      }

      .phone-card {
        padding: clamp(1.25rem, 2.2vw, 2rem) clamp(0.25rem, 0.5vw, 0.5rem);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .phone-card.in-view {
        opacity: 1;
        transform: translateY(0);
      }

      .phone-card:focus-visible {
        outline-offset: 6px;
      }

      .phone-frame {
        position: relative;
        width: 100%;
        aspect-ratio: 9 / 19.1;
        border-radius: 16px;
        border: 4px solid var(--frame-color, #0a0a0a);
        background: #000;
        overflow: hidden;
        transform: perspective(700px) rotateX(0deg) rotateY(0deg) scale(1);
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
          box-shadow 0.35s ease;
        box-shadow: 0 0 0 rgba(10, 10, 10, 0);
      }

      .phone-card:hover .phone-frame,
      .phone-card:focus-visible .phone-frame {
        box-shadow: 0.5rem 0.75rem 0 rgba(10, 10, 10, 0.1);
      }

      .phone-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
        pointer-events: none;
        transition: transform 0.5s ease;
      }

      .phone-card:hover .phone-frame img {
        transform: scale(1.03);
      }

      .phone-frame.launched {
        animation: pulse-launch 0.5s ease;
      }

      @keyframes pulse-launch {
        0% {
          box-shadow: 0 0 0 0 var(--frame-color, #ff3b00);
        }
        60% {
          box-shadow: 0 0 0 10px rgba(255, 59, 0, 0);
        }
        100% {
          box-shadow: 0.5rem 0.75rem 0 rgba(10, 10, 10, 0.1);
        }
      }

      /* ---------- Responsive ---------- */

      /* Tablet (≤ 900px) */
      @media (max-width: 900px) {
        .masthead {
          grid-template-columns: 1fr;
        }
        .col-logo {
          border-right: none;
          border-bottom: 1px solid var(--border);
          padding-bottom: 1.25rem;
        }
        .col-content {
          min-height: auto;
        }
        .hero-copy {
          padding-top: 2rem;
        }
        .content-top {
          flex-direction: column;
          gap: 0.75rem;
        }
        .wordmark {
          font-size: clamp(4rem, 12vw, 120px);
        }
        .tagline {
          font-size: 18px;
          max-width: 100%;
        }
        nav li a {
          font-size: 16px;
        }
        .contact-line {
          font-size: 16px;
        }
      }

      /* Phone (≤ 600px) */
      @media (max-width: 600px) {
        .col-logo {
          padding: 1rem 0.75rem 1rem 0.75rem;
        }
        .col-content {
          padding: 1rem 0.75rem;
        }
        .hero-copy {
          padding-top: 1.5rem;
        }
        .wordmark {
          font-size: clamp(3rem, 16vw, 80px);
        }
        .tagline {
          font-size: 15px;
        }
        nav li a {
          font-size: 14px;
        }
        .contact-line {
          font-size: 14px;
        }
        .screens {
          grid-template-columns: repeat(2, 1fr);
        }
        .phone-card {
          padding: 1rem 0.4rem;
        }
      }

      /* Small phone (≤ 400px) */
      @media (max-width: 400px) {
        .wordmark {
          font-size: clamp(2.5rem, 18vw, 60px);
        }
        .screens {
          grid-template-columns: repeat(1, 1fr);
          max-width: 260px;
          margin: 0 auto;
        }
      }

      @media (max-width: 720px) {
        .screens {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition-duration: 0.001ms !important;
          animation-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="masthead">
      <div class="col-logo">
        <a href="#" class="logo" aria-label="Basin home">
          <span class="logo-mark">BASIN</span><sup>®</sup>
        </a>
      </div>

      <div class="col-content">
        <div class="content-top">
          <nav aria-label="Primary">
            <ul id="nav-list">
              {
                navLinks.map((link) => (
                  <li>
                    <a href={link.href} data-active={link.active ? "true" : "false"}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <a href="mailto:hello@basin.agency" class="contact-line"
            >HELLO@BASIN.AGENCY</a
          >
        </div>

        <div class="hero-copy">
          <div class="wordmark-wrap">
            <h1 class="wordmark" id="wordmark" aria-label="Basin">
              {
                wordmark.map((letter, i) => (
                  <span class="letter" data-i={i} aria-hidden="true">
                    {letter}
                  </span>
                ))
              }
            </h1>
          </div>

          <p class="tagline" id="tagline">
            {
              taglineWords.map((word) => (
                <span>
                  {word}
                  {"\u00A0"}
                </span>
              ))
            }
          </p>
        </div>
      </div>
    </header>

    <section class="screens" aria-label="Selected app work">
      {
        apps.map((app) => (
          <article class="phone-card" tabindex="0" data-accent={app.accent}>
            <div class="phone-frame" style={`--frame-color:${app.accent}`}>
              <img src={app.src} alt="" loading="lazy" />
            </div>
          </article>
        ))
      }
    </section>

    <script>
      // ---------- shared helpers ----------
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      // ---------- nav focus-dim ----------
      const navList = document.getElementById("nav-list");
      if (navList) {
        const nav = navList.closest("nav");
        navList.addEventListener("mouseenter", () => nav?.classList.add("is-hovering"));
        navList.addEventListener("mouseleave", () => nav?.classList.remove("is-hovering"));
      }

      // ---------- wordmark magnetic letters ----------
      const wordmarkEl = document.getElementById("wordmark");
      if (wordmarkEl && !reduceMotion) {
        const letters = Array.from(wordmarkEl.querySelectorAll(".letter"));

        wordmarkEl.addEventListener("mousemove", (e) => {
          const rect = wordmarkEl.getBoundingClientRect();
          const cursorX = e.clientX - rect.left;

          letters.forEach((letter) => {
            const lRect = letter.getBoundingClientRect();
            const letterCenter = lRect.left - rect.left + lRect.width / 2;
            const distance = Math.abs(cursorX - letterCenter);
            const influence = Math.max(0, 1 - distance / 180);
            const lift = influence * 22;

            letter.style.transform = `translateY(${-lift}px)`;
            letter.classList.toggle("hot", influence > 0.55);
          });
        });

        wordmarkEl.addEventListener("mouseleave", () => {
          letters.forEach((letter) => {
            letter.style.transform = "translateY(0)";
            letter.classList.remove("hot");
          });
        });
      }

      // ---------- tagline scroll reveal ----------
      const tagline = document.getElementById("tagline");
      if (tagline) {
        const words = Array.from(tagline.querySelectorAll("span"));
        words.forEach((word, i) => {
          word.style.transitionDelay = `${i * 18}ms`;
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                tagline.classList.add("in-view");
                observer.disconnect();
              }
            });
          },
          { threshold: 0.3 }
        );
        observer.observe(tagline);
      }

      // ---------- phone cards: reveal + tilt + launch ----------
      const phoneCards = Array.from(document.querySelectorAll(".phone-card"));

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const index = phoneCards.indexOf(el);
              window.setTimeout(() => {
                el.classList.add("in-view");
              }, Math.max(0, index) * 70);
              revealObserver.unobserve(el);
            }
          });
        },
        { threshold: 0.15 }
      );

      phoneCards.forEach((card) => {
        revealObserver.observe(card);

        const frame = card.querySelector(".phone-frame");

        if (frame && !reduceMotion) {
          card.addEventListener("mousemove", (e) => {
            const rect = frame.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            frame.style.transform = `perspective(700px) rotateX(${
              y * -8
            }deg) rotateY(${x * 10}deg) scale(1.03)`;
          });

          card.addEventListener("mouseleave", () => {
            frame.style.transform =
              "perspective(700px) rotateX(0deg) rotateY(0deg) scale(1)";
          });
        }

        const launch = () => {
          if (!frame) return;
          frame.classList.remove("launched");
          void frame.offsetWidth;
          frame.classList.add("launched");
          window.setTimeout(() => frame.classList.remove("launched"), 700);
        };

        card.addEventListener("click", launch);
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            launch();
          }
        });
      });
    </script>
  </body>
</html>

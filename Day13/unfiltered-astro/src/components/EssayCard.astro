---
interface Props {
  image: string;
  caption: string;
  href?: string;
  tall?: boolean;
}

const { image, caption, href = '#', tall = false } = Astro.props;
---

<a href={href} class="essay-card">
  <div class="essay-card-image-wrap" class:list={["essay-card-image-wrap", { tall }]}>
    <img src={image} alt="Essay photograph" class="essay-card-image" />
  </div>
  <p class="essay-card-caption">{caption}</p>
</a>

<style>
  .essay-card {
    flex-shrink: 0;
    width: 370px;
    display: block;
  }

  .essay-card-image-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 20px;
  }

  .essay-card-image-wrap.tall {
    aspect-ratio: 2 / 3;
  }

  .essay-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .essay-card:hover .essay-card-image {
    transform: scale(1.04);
  }

  .essay-card-caption {
    margin: 18px auto 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-red-dark);
    text-align: center;
    line-height: 1.5;
    max-width: 280px;
  }

  @media (max-width: 768px) {
    .essay-card {
      width: 280px;
    }

    .essay-card-caption {
      max-width: 220px;
      font-size: 0.85rem;
    }
  }
</style>

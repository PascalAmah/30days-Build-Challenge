---
import NavOverlay from '../components/NavOverlay.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nav Overlay — Astro</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        background: #13140c;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
      * { box-sizing: border-box; }
    </style>
  </head>
  <body>
    <NavOverlay />
  </body>
</html>

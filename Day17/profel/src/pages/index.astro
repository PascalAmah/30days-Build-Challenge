    {
        name: "MICHAEL JORDAN",
        id: "michael-jordan",
        accent: "#F2E9DC",
        rotate: -6,
        top: "8%",
        left: "37%",
        art: "flowers",
        image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=260&fit=crop",
    },
    {
        name: "RACHAEL ROW",
        id: "rachael-row",
        accent: "#F6D9C8",
        rotate: 3,
        top: "22%",
        left: "34%",
        art: "pinkhair",
        image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200&h=260&fit=crop",
    },
    {
        name: "EMMANUEL PHILIP",
        id: "emmanuel-philip",
        accent: "#EDEDED",
        rotate: -4,
        top: "18%",
        left: "50%",
        art: "braids",
        image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=200&h=260&fit=crop",
    },
    {
        name: "OCHE RHOLLAND",
        id: "oche-rholland",
        accent: "#EFEFEF",
        rotate: 5,
        top: "40%",
        left: "44%",
        art: "afro",
        image: "https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=200&h=260&fit=crop",
    },
    {
        name: "EMILI PETER",
        id: "emili-peter",
        accent: "#DCE7E3",
        rotate: -3,
        top: "38%",
        left: "56%",
        art: "shades",
        image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&h=260&fit=crop",
    },
    {
        name: "JAMES ED",
        id: "james-ed",
        accent: "#CDEAF5",
        rotate: 6,
        top: "48%",
        left: "38%",
        art: "tennisball",
        image: "https://images.unsplash.com/photo-1508341591423-4347099e1f19?w=200&h=260&fit=crop",
    },
    {
        name: "OBI THOMPSON",
        id: "obi-thompson",
        accent: "#E7E1F5",
        rotate: -5,
        top: "56%",
        left: "50%",

---
const columns = [
  {
    title: 'Services',
    links: ['Consistency', 'Building in public', 'Showing up daily'],
  },
  {
    title: 'Resources',
    links: ['Blog', 'Events', 'Product demos'],
  },
  {
    title: 'Solutions',
    links: ['Sales Enablement', 'Performance Analytics', 'Conversion Tracking'],
  },
  {
    title: 'Company',
    links: ['About Us', 'Careers', 'Contact'],
  },
];
---

<footer class="site-footer">
  <nav class="footer-nav" data-reveal data-reveal-delay="300">
    {columns.map((col) => (
      <div class="footer-col">
        <p class="footer-col-title">{col.title}</p>
        <ul>
          {col.links.map((link) => (
            <li><a href="#">{link}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <div class="wordmark-row" data-reveal data-reveal-delay="450">
    <img src="/Shape.svg" class="logo-mark" alt="Dezo-zina logo" aria-hidden="true" />
    <h2 class="wordmark">Dezo&#8212;zina</h2>
  </div>

  <div class="bottom-bar" data-reveal data-reveal-delay="550">
    <div class="bottom-bar-left">
      <img src="/Shape.svg" class="logo-mark small" alt="" aria-hidden="true" />
      <span>2026 DEZO &#169; All rights reserved.</span>
    </div>
    <div class="bottom-bar-right">
      <a href="#" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M13.5 21v-7.6h2.6l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46h1.6V4.28C16.3 4.2 15.32 4.1 14.2 4.1c-2.35 0-3.96 1.43-3.96 4.06v2.24H7.6v3h2.64V21h3.26Z"/></svg>
      </a>
      <a href="#" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.2c2.7 0 3 0 4.1.06 1.02.05 1.66.2 2.05.34.5.19.87.42 1.25.8.38.38.6.75.8 1.25.14.4.29 1.03.34 2.05.06 1.1.06 1.4.06 4.1s0 3-.06 4.1c-.05 1.02-.2 1.66-.34 2.05-.19.5-.42.87-.8 1.25-.38.38-.75.6-1.25.8-.4.14-1.03.29-2.05.34-1.1.06-1.4.06-4.1.06s-3 0-4.1-.06c-1.02-.05-1.66-.2-2.05-.34a3.4 3.4 0 0 1-1.25-.8 3.4 3.4 0 0 1-.8-1.25c-.14-.4-.29-1.03-.34-2.05C2.2 15 2.2 14.7 2.2 12s0-3 .06-4.1c.05-1.02.2-1.66.34-2.05.19-.5.42-.87.8-1.25.38-.38.75-.6 1.25-.8.4-.14 1.03-.29 2.05-.34C7.8 2.2 8.1 2.2 12 2.2Zm0 1.8c-2.65 0-2.96 0-4.02.06-.86.04-1.33.18-1.64.3-.41.16-.7.35-1.02.66-.31.32-.5.6-.66 1.02-.12.31-.26.78-.3 1.64C4.3 8.74 4.3 9.05 4.3 12s0 2.96.06 4.02c.04.86.18 1.33.3 1.64.16.41.35.7.66 1.02.32.31.61.5 1.02.66.31.12.78.26 1.64.3 1.06.06 1.37.06 4.02.06s2.96 0 4.02-.06c.86-.04 1.33-.18 1.64-.3.41-.16.7-.35 1.02-.66.31-.32.5-.61.66-1.02.12-.31.26-.78.3-1.64.06-1.06.06-1.37.06-4.02s0-2.96-.06-4.02c-.04-.86-.18-1.33-.3-1.64a2.7 2.7 0 0 0-.66-1.02 2.7 2.7 0 0 0-1.02-.66c-.31-.12-.78-.26-1.64-.3C14.96 4 14.65 4 12 4Zm0 3.05a4.95 4.95 0 1 1 0 9.9 4.95 4.95 0 0 1 0-9.9Zm0 1.8a3.15 3.15 0 1 0 0 6.3 3.15 3.15 0 0 0 0-6.3Zm5.15-2a1.16 1.16 0 1 1-2.32 0 1.16 1.16 0 0 1 2.32 0Z"/></svg>
      </a>
      <a href="#" aria-label="X">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.24 3H21l-6.5 7.43L22.2 21h-6.14l-4.8-6.27L5.7 21H2.93l7-8L1.98 3h6.29l4.34 5.74L18.24 3Zm-1.08 16.2h1.7L7.9 4.7H6.08l11.08 14.5Z"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(12px, 2vw, 32px) 24px;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    padding-top: clamp(12px, 2vw, 32px);
    border-top: 1px solid var(--hairline);
  }

  .footer-col-title {
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col a {
    font-size: 14px;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--fg);
  }

  .wordmark-row {
    display: flex;
    align-items: flex-start;
    gap: clamp(10px, 2vw, 26px);
    margin-top: clamp(40px, 8vw, 90px);
    color: var(--accent);
  }

  .logo-mark {
    width: clamp(48px, 15vw, 238px);
    height: clamp(48px, 15vw, 238px);
    flex-shrink: 0;
  }

  .logo-mark.small {
    width: 20.94px;
    height: 20.94px;
  }

  .wordmark {
    margin: 0;
    font-family: 'ZT Bros Oskon 90s', var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(40px, 18vw, 334px);
    line-height: 0.85;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .bottom-bar {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .bottom-bar-left {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 13px;
  }

  .bottom-bar-left .logo-mark {
    color: var(--muted);
  }

  .bottom-bar-right {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--muted);
  }

  .bottom-bar-right a {
    display: inline-flex;
    transition: color 0.2s ease;
  }

  .bottom-bar-right a:hover,
  .bottom-bar-right a:focus-visible {
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .footer-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }
</style>

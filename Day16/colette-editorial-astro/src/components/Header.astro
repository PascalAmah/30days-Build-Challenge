---

---

<header class="site-header">
    <div class="wrap header-row">
        <hr class="rule" />
        <a href="/" class="logo" data-reveal-fade
            >Colette<span class="reg">®</span></a
        >

        <p class="subhead uppercase" data-reveal-fade>
            We are specialised in art directed content production for high end
            fashion and lifestyle brands. Working from beautiful Paris.
        </p>

        <nav class="nav uppercase" data-reveal-fade>Work, services, about</nav>

        <div class="cta-col" data-reveal-fade>
            <button class="open-btn uppercase mobile-only" type="button"
                >Open</button
            >
            <a href="#contact" class="reach uppercase desktop-only"
                >Reach out to us</a
            >
            <hr class="rule reach-rule desktop-only" />
        </div>
    </div>
    <hr class="rule mobile-only" />
</header>

<style>
    .site-header {
        background: var(--bg);
    }

    .header-row {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        padding-top: 0;
        padding-bottom: 20px;
        row-gap: 10px;
    }

    .header-row :global(.rule) {
        grid-column: 1 / -1;
    }

    .logo {
        font-family: var(--mono);
        font-weight: 700;
        font-size: 22px;
        text-decoration: none;
        letter-spacing: 0.01em;
        grid-column: 1 / 2;
    }

    .reg {
        font-size: 12px;
        vertical-align: super;
    }

    .subhead {
        display: none;
    }

    .nav {
        display: none;
    }

    .cta-col {
        grid-column: 2 / 3;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .open-btn {
        font-family: var(--mono);
        background: var(--ink);
        color: var(--bg);
        border: none;
        padding: 8px 16px;
        font-size: 12px;
        letter-spacing: 0.05em;
        cursor: pointer;
    }

    .reach {
        text-decoration: none;
        font-size: 12px;
        letter-spacing: 0.03em;
        white-space: nowrap;
    }

    .reach-rule {
        width: 100%;
        margin-top: 6px;
    }

    .desktop-only {
        display: none;
    }

    @media (min-width: 900px) {
        .header-row {
            grid-template-columns: auto 1fr auto auto;
            column-gap: var(--gap);
            align-items: start;
            padding-top: 28px;
            padding-bottom: 28px;
        }

        .logo {
            font-size: 30px;
            grid-column: 1 / 2;
        }

        .subhead {
            display: block;
            grid-column: 2 / 3;
            max-width: 420px;
            font-size: 12px;
            line-height: 1.6;
            margin: 4px 0 0;
        }

        .nav {
            display: block;
            grid-column: 3 / 4;
            font-size: 12px;
            justify-self: start;
            margin-top: 4px;
            white-space: nowrap;
        }

        .cta-col {
            grid-column: 4 / 5;
        }

        .mobile-only {
            display: none;
        }

        .desktop-only {
            display: block;
        }
    }
</style>

---
const primaryNav = [
  { label: "New In", href: "/new-in" },
  { label: "Clothing", href: "/clothing" },
  { label: "Dresses", href: "/dresses" },
  { label: "Petite", href: "/petite" },
  { label: "Shoes", href: "/shoes" },
  { label: "Accessories", href: "/accessories" },
  { label: "Archive", href: "/archive" },
  { label: "Stories", href: "/stories" },
];

const tabs = [
  { label: "What's New", href: "#new" },
  { label: "Ready to Wear", href: "#ready-to-wear" },
  { label: "Dresses", href: "#dresses" },
  { label: "Footwear", href: "#footwear" },
];
---

<header class="site-header">
  <div class="bar">
    <a class="logo" href="/">Everkind</a>

    <nav class="primary" aria-label="Primary">
      <ul>
        {primaryNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn search-toggle" type="button" aria-label="Search" data-search-toggle>
        <span class="search-label">Search</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5.4" stroke="currentColor" stroke-width="1.1"></circle>
          <path d="M11 11L14.5 14.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
        </svg>
      </button>
      <a class="icon-btn hide-mobile" href="/saved" aria-label="Saved items">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 2.5h9a.5.5 0 0 1 .5.5v10.6a.4.4 0 0 1-.63.33L8 10.2l-4.37 3.72a.4.4 0 0 1-.63-.32V3a.5.5 0 0 1 .5-.5Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="icon-btn hide-mobile" href="/account" aria-label="Account">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="5.3" r="2.6" stroke="currentColor" stroke-width="1.1"></circle>
          <path d="M2.6 14c.9-2.7 3-4.2 5.4-4.2s4.5 1.5 5.4 4.2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
        </svg>
      </a>
      <a class="icon-btn hide-mobile" href="/cart" aria-label="Cart">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4.6h12l-.9 7.2a1 1 0 0 1-1 .9H3.9a1 1 0 0 1-1-.9L2 4.6Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"></path>
          <path d="M5.2 4.6V4a2.8 2.8 0 1 1 5.6 0v.6" stroke="currentColor" stroke-width="1.1"></path>
        </svg>
      </a>
      <button class="icon-btn menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
        <span>{"{ MENU }"}</span>
      </button>
    </div>
  </div>

  <div class="search-panel" data-search-panel hidden>
    <div class="search-panel-inner">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5.4" stroke="currentColor" stroke-width="1.1"></circle>
        <path d="M11 11L14.5 14.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
      </svg>
      <input type="text" placeholder="Search products, edits, stories&hellip;" aria-label="Search" />
      <button type="button" aria-label="Close search" data-search-close>&times;</button>
    </div>
  </div>

  <nav class="tabs" aria-label="Collection tabs">
    {tabs.map((tab, i) => (
      <a href={tab.href} class:list={["tab", { active: i === 0 }]}>{tab.label}</a>
    ))}
  </nav>

  <div class="mobile-nav" data-mobile-nav hidden>
    <ul>
      {primaryNav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <ul class="mobile-utility">
      <li><a href="/saved">Saved</a></li>
      <li><a href="/account">Account</a></li>
      <li><a href="/cart">Cart</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--surface-0);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px var(--gutter);
  }

  .logo {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: 0.01em;
    color: var(--ink-0);
    text-decoration: none;
    flex-shrink: 0;
  }

  .primary ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary a {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-1);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .primary a:hover {
    color: var(--ink-0);
    border-color: var(--ink-0);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    color: var(--ink-0);
    cursor: pointer;
    padding: 8px;
  }

  .search-label {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .menu-toggle {
    display: none;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .search-panel {
    border-bottom: 1px solid var(--line);
    background: var(--surface-1);
  }

  .search-panel[hidden] {
    display: none;
  }

  .search-panel-inner {
    max-width: 620px;
    margin: 0 auto;
    padding: 16px var(--gutter);
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-2);
  }

  .search-panel-inner input {
    flex: 1;
    border: none;
    background: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--ink-0);
    outline: none;
  }

  .search-panel-inner button {
    border: none;
    background: none;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--ink-2);
    cursor: pointer;
  }

  .tabs {
    display: flex;
    gap: 28px;
    padding: 14px var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tab.active {
    color: var(--ink-0);
    font-weight: 600;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    padding: 20px var(--gutter) 26px;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .mobile-nav a {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink-0);
    text-decoration: none;
  }

  .mobile-utility {
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex !important;
    flex-direction: row !important;
    gap: 20px !important;
  }

  .mobile-utility a {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .primary {
      display: none;
    }

    .hide-mobile {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .search-label {
      display: none;
    }

    .bar {
      padding: 16px var(--gutter);
    }

    .logo {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  const searchToggle = document.querySelector<HTMLButtonElement>("[data-search-toggle]");
  const searchPanel = document.querySelector<HTMLElement>("[data-search-panel]");
  const searchClose = document.querySelector<HTMLButtonElement>("[data-search-close]");
  const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  searchToggle?.addEventListener("click", () => {
    const isHidden = searchPanel?.hasAttribute("hidden");
    if (isHidden) {
      searchPanel?.removeAttribute("hidden");
      searchPanel?.querySelector("input")?.focus();
    } else {
      searchPanel?.setAttribute("hidden", "");
    }
  });

  searchClose?.addEventListener("click", () => {
    searchPanel?.setAttribute("hidden", "");
  });

  menuToggle?.addEventListener("click", () => {
    const expanded = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!expanded));
    menuToggle.querySelector("span")!.textContent = expanded ? "{ MENU }" : "{ CLOSE }";
    if (expanded) {
      mobileNav?.setAttribute("hidden", "");
    } else {
      mobileNav?.removeAttribute("hidden");
    }
  });
</script>

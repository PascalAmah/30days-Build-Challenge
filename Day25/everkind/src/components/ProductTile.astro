---
import { Image } from "astro:assets";
import { formatNaira, type Product } from "../data/products";

interface Props {
  product: Product;
  image: ImageMetadata;
  imageAlt: string;
  area?: string;
  ratio?: string;
  priority?: boolean;
}

const { product, image, imageAlt, area, ratio = "3 / 4", priority = false } = Astro.props;
---

<article class="tile" style={area ? `grid-area:${area};` : undefined}>
  <a class="frame" href={`/products/${product.slug}`} style={`aspect-ratio:${ratio};`}>
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 700, 1000]}
      sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 25vw"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      class="photo"
    />
    <span class="badge">{product.badge}</span>
    <button class="save" type="button" aria-label="Save to wishlist" data-save>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3.5 2.5h9a.5.5 0 0 1 .5.5v10.6a.4.4 0 0 1-.63.33L8 10.2l-4.37 3.72a.4.4 0 0 1-.63-.32V3a.5.5 0 0 1 .5-.5Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"></path>
      </svg>
    </button>
  </a>
  <div class="meta">
    <div class="meta-row">
      <h3><a href={`/products/${product.slug}`}>{product.name}</a></h3>
      <p class="price">{formatNaira(product.price)}</p>
    </div>
    <p class="colours">{product.colours} Colour{product.colours > 1 ? "s" : ""}</p>
  </div>
</article>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--surface-2);
    width: 100%;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .frame:hover .photo {
      transform: scale(1.045);
    }
  }

  .badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--surface-0);
    color: var(--ink-0);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    padding: 6px 10px;
    line-height: 1;
    z-index: 2;
  }

  .save {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 2;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    color: var(--ink-0);
    cursor: pointer;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease, color 0.2s ease;
  }

  @media (hover: hover) {
    .frame:hover .save {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .save:focus-visible {
    opacity: 1;
    transform: translateY(0);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .save[data-active="true"] svg path {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .meta {
    padding-top: 14px;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  h3 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.35;
  }

  h3 a {
    color: var(--ink-0);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .price {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    margin: 0;
    white-space: nowrap;
    color: var(--ink-0);
  }

  .colours {
    margin: 4px 0 0;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const active = btn.getAttribute("data-active") === "true";
      btn.setAttribute("data-active", String(!active));
    });
  });
</script>

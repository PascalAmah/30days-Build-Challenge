---
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  area?: string;
}

const { image, imageAlt, area } = Astro.props;
---

<article class="story" style={area ? `grid-area:${area};` : undefined}>
  <a class="frame" href="/stories/sustainability-standard">
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 700, 1100]}
      sizes="(max-width: 900px) 100vw, 50vw"
      loading="lazy"
      class="photo"
    />
    <span class="badge">Blogs</span>
  </a>

  <div class="excerpt">
    <Image src={image} alt="" width={64} height={64} loading="lazy" class="thumb" />
    <div>
      <p class="headline">Sustainability isn&rsquo;t a trend, it&rsquo;s our standard.</p>
      <p class="snippet">From recycled fibres to low&#8209;impact dyes, we&rsquo;re committed to reducing waste and designing clothes you&rsquo;ll keep wearing.</p>
      <a class="read-more" href="/stories/sustainability-standard">Read Report</a>
    </div>
  </div>
</article>

<style>
  .story {
    position: relative;
    min-width: 0;
    height: 100%;
  }

  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    height: 100%;
    min-height: 380px;
    background: var(--surface-2);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .frame:hover .photo {
      transform: scale(1.03);
    }
  }

  .badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--surface-0);
    color: var(--ink-0);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    padding: 6px 10px;
    z-index: 2;
  }

  .excerpt {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: flex;
    gap: 12px;
    background: var(--surface-0);
    padding: 14px;
    max-width: 400px;
  }

  .thumb {
    width: 56px;
    height: 56px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .headline {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.3;
    margin: 0 0 6px;
    color: var(--ink-0);
  }

  .snippet {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0 0 8px;
  }

  .read-more {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--ink-0);
  }

  .read-more:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .excerpt {
      position: absolute;
      right: 12px;
      bottom: 12px;
      left: 12px;
      max-width: none;
    }

    .frame {
      min-height: 60vh;
    }
  }
</style>

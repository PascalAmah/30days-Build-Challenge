---

---

<section class="benefit">
    <div class="container">
        <div class="head">
            <div>
                <p class="eyebrow">Benefit</p>
                <h2>Your gut knows, so does your Candy</h2>
            </div>
            <a class="browse" href="#shop">Browse more →</a>
        </div>

        <div class="grid">
            <!-- col 1 top: rainbow candy twist -->
            <div class="cell c1" style="background:var(--grid-olive)">
                <img
                    src="/rainbow-twist.png"
                    alt="Rainbow sour candy twist"
                    loading="lazy"
                />
            </div>

            <!-- col 2 top: text card -->
            <div class="cell c2" style="background:var(--grid-pink)">
                <p class="card-text">
                    One candy a day makes the mind rich, and the body strong!
                </p>
            </div>

            <!-- col 3 top: striped wrapped candy -->
            <div class="cell c3" style="background:var(--grid-chartreuse)">
                <img
                    src="/striped-candy.png"
                    alt="Pink striped wrapped candy"
                    loading="lazy"
                />
            </div>

            <!-- col 1 tall: bubble gum tape -->
            <div class="cell c4" style="background:var(--grid-peach)">
                <img
                    src="/bubble-tape.png"
                    alt="Bubble gum tape"
                    loading="lazy"
                />
            </div>

            <!-- col 2 middle: candy hills photo -->
            <div class="cell c5" style="background:var(--cream-soft)">
                <img
                    src="/candy-hills.png"
                    alt="Candy land hills with lollipops"
                    loading="lazy"
                />
            </div>

            <!-- col 2 bottom: text card -->
            <div class="cell c6" style="background:#FFF2DE">
                <p class="card-text">
                    Join the free club for access to healthy candies and gum.
                </p>
            </div>

            <!-- col 3 tall: candy land scene -->
            <div class="cell c7" style="background:var(--grid-sky)">
                <img
                    src="/candy-land.png"
                    alt="Candy land scene with cotton candy and lollipops"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</section>

<style>
    .benefit {
        padding-block: 72px 40px;
    }

    .head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 32px;
        flex-wrap: wrap;
    }

    .eyebrow {
        text-transform: uppercase;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: var(--maroon);
        margin-bottom: 10px;
    }

    h2 {
        font-family: "Freckle Face", var(--font-display);
        color: var(--maroon);
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        max-width: 480px;
        line-height: 1.15;
    }

    .browse {
        flex-shrink: 0;
        background: var(--lavender);
        color: var(--maroon-deep);
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        padding: 14px 22px;
        border-radius: 10px;
        transition:
            transform 0.2s ease,
            background 0.2s ease;
    }

    .browse:hover {
        background: var(--lavender-deep);
        transform: translateY(-2px);
    }

    /* mobile: full-width stacked */
    .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .cell {
        position: relative;
        overflow: hidden;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 220px;
    }

    .card-text {
        font-family: "Fraunces", var(--font-serif);
        font-weight: 400;
        font-size: 24px;
        text-align: center;
        color: var(--maroon-deep);
        line-height: 1.3;
        padding: 24px 16px;
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .cell:hover .card-text {
        transform: scale(1.05);
    }

    .cell img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform;
    }

    .cell:hover img {
        transform: scale(1.08);
    }

    @media (min-width: 720px) {
        .grid {
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, minmax(180px, auto));
            gap: 14px;
        }

        .c1 {
            grid-column: 1;
            grid-row: 1;
        }
        .c4 {
            grid-column: 1;
            grid-row: 2 / 4;
            min-height: 380px;
        }
        .c2 {
            grid-column: 2;
            grid-row: 1;
        }
        .c5 {
            grid-column: 2;
            grid-row: 2;
        }
        .c6 {
            grid-column: 2;
            grid-row: 3;
        }
        .c3 {
            grid-column: 3;
            grid-row: 1 / 3;
            min-height: 380px;
        }
        .c7 {
            grid-column: 3;
            grid-row: 3;
        }
    }
</style>
